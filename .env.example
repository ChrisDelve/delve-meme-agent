# Delve Meme Agent — production live-process environment template
#
# Every value below is intentionally blank.
# Supply explicit values through the deployment environment or a private .env.
# NEVER commit real secrets.
#
# DELVE_LIVE_DB_PATH must point to durable/persistent storage in production.
# Do NOT point the live process at logs/delve_meme.db.

# Operating / capital-risk configuration
DELVE_LIVE_DB_PATH=
DELVE_LIVE_RECOVERY_INTERVAL_SECONDS=
DELVE_LIVE_OPERATIONAL_KILL=
